# The Classic Crush — Environment Configuration
# All variables below are optional. The application functions out-of-the-box with default credentials:
# Admin Email: admin@classiccrush.cafe
# Admin Password: admin123

# Admin Credentials (Vite Frontend & Vercel Serverless Function)
VITE_ADMIN_EMAIL=admin@classiccrush.cafe
VITE_ADMIN_PASSWORD=admin123

# Server-Side Environment Variables (Vercel Serverless Functions in /api)
ADMIN_EMAIL=admin@classiccrush.cafe
ADMIN_PASSWORD=admin123
ADMIN_SESSION_SECRET=tcc_classic_crush_production_secret_key_2026

# Optional Remote Database (Supabase)
# VITE_SUPABASE_URL=https://your-project.supabase.co
